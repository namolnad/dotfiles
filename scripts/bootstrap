#!/usr/bin/env bash
#
# Sets up a Mac from this repo, or brings one up to date.
#
#   scripts/bootstrap            everything, including macOS settings and login
#                                items; asks for your password once, up front
#   scripts/bootstrap --update   packages, plugins and dotfiles only (make update)
#   scripts/bootstrap --dry-run  print what would change instead of changing it
#
# On a new Mac, before anything else is installed:
#
#   curl -fsSL https://raw.githubusercontent.com/namolnad/dotfiles/main/scripts/bootstrap | bash
#
# That asks for your password, sets up an SSH key and waits for GitHub to
# accept it, clones this repo and carries on from the clone without asking
# anything else.
#
# Every step checks before it acts, so a re-run only does what's left. A
# failing step is recorded and the run carries on; the summary at the end lists
# what failed, what's left to do by hand and what needs a restart, and the exit
# status is non-zero if any step failed. Written for macOS's bash 3.2.

# Steps run through `step <name> <function>`, which shellcheck can't follow
# shellcheck disable=SC2329
set -uo pipefail

DOTFILES=${DOTFILES:-$HOME/Developer/dotfiles}
DOTFILES_REPO=git@github.com:namolnad/dotfiles.git
STATE_DIR=$HOME/.local/state/dotfiles

# Custom oh-my-zsh plugins, cloned into ~/.oh-my-zsh/custom/plugins
ZSH_PLUGINS=(mroth/evalcache zsh-users/zsh-completions Aloxaf/fzf-tab)

# gh extensions every machine gets (owner/repo); --update upgrades whatever is installed
GH_EXTENSIONS=(despreston/gh-worktree)

LOGIN_ITEMS=(
  /Applications/AeroSpace.app
  /Applications/Rocket.app
  /Applications/zoom.us.app
  /Applications/1Password.app
  /Applications/AutoMute.app
)

MODE=bootstrap
DRY_RUN=0
ARGS=("$@")

RESULTS=() # status|step|detail
MANUAL=()
NOTES=()
STEP_STATUS=
STEP_DETAIL=
CASK_SKIP=
ASKPASS_DIR=${BOOTSTRAP_ASKPASS_DIR:-}
LOG=''
TMUX_BEFORE=''
NVIM_BEFORE=''

if [[ -t 1 ]]; then
  bold=$'\033[1m' dim=$'\033[2m' red=$'\033[31m' green=$'\033[32m'
  yellow=$'\033[33m' blue=$'\033[34m' reset=$'\033[0m'
else
  bold='' dim='' red='' green='' yellow='' blue='' reset=''
fi

# --- output and step bookkeeping ---------------------------------------------

heading() { printf '\n%s==> %s%s\n' "$blue$bold" "$*" "$reset"; }
detail() { printf '    %s\n' "$*"; }
warn() { printf '    %s! %s%s\n' "$yellow" "$*" "$reset"; }
manual() { MANUAL+=("$*"); }
note() { NOTES+=("$*"); }

skip() {
  STEP_STATUS=skipped STEP_DETAIL=$*
  detail "${dim}skipped: $*$reset"
}

# The reason a step is about to fail, for the summary
reason() { STEP_DETAIL=$*; }

# Marks a step that finished but left something undone
degrade() {
  [[ $STEP_STATUS == ok ]] && STEP_STATUS=warning
  STEP_DETAIL=$*
  warn "$*"
}

step() {
  local name=$1 rc
  shift
  STEP_STATUS=ok STEP_DETAIL=
  heading "$name"
  "$@"
  rc=$?
  if ((rc != 0)); then
    STEP_STATUS=failed
    [[ -n $STEP_DETAIL ]] || STEP_DETAIL="exit status $rc"
    printf '    %s✗ %s%s\n' "$red" "$STEP_DETAIL" "$reset"
  fi
  RESULTS+=("$STEP_STATUS|$name|$STEP_DETAIL")
  return 0
}

last_step_failed() { [[ ${RESULTS[${#RESULTS[@]} - 1]} == failed\|* ]]; }

# Runs a command that changes something, or only prints it in a dry run. The
# command line goes to stderr so callers can capture the command's output.
run() {
  printf '    %s$ %s%s\n' "$dim" "$*" "$reset" >&2
  ((DRY_RUN)) && return 0
  "$@"
}

# run, but shows a label instead of the command (an installer script's text)
run_as() {
  local label=$1
  shift
  printf '    %s$ %s%s\n' "$dim" "$label" "$reset" >&2
  ((DRY_RUN)) && return 0
  "$@"
}

have_tty() { { : </dev/tty; } 2>/dev/null; }

# --- sudo ----------------------------------------------------------------------

# Homebrew resets sudo's timestamp after every command, so a cached sudo
# doesn't last. The password is asked for once instead, and handed to sudo
# (ours with -A, Homebrew's whenever SUDO_ASKPASS is set) by a helper in a
# private temporary directory that's deleted when the run ends.
ensure_sudo() {
  [[ -n ${SUDO_ASKPASS:-} && -x ${SUDO_ASKPASS:-} ]] && return 0
  ((DRY_RUN)) && return 0
  have_tty || return 1
  local dir pw tries=0
  dir=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-askpass.XXXXXX") || return 1
  chmod 700 "$dir"
  while ((tries < 3)); do
    printf '%sPassword for sudo (asked once):%s ' "$bold" "$reset" >/dev/tty
    IFS= read -rs pw </dev/tty
    printf '\n' >/dev/tty
    printf '%s\n' "$pw" | sudo -S -p '' -v 2>/dev/null && break
    pw='' tries=$((tries + 1))
  done
  if [[ -z $pw ]]; then
    rmdir "$dir"
    return 1
  fi
  (umask 077 && printf '%s\n' "$pw" >"$dir/password")
  printf '#!/bin/sh\nexec cat "%s/password"\n' "$dir" >"$dir/askpass"
  chmod 700 "$dir/askpass"
  pw=
  ASKPASS_DIR=$dir
  export SUDO_ASKPASS=$dir/askpass BOOTSTRAP_ASKPASS_DIR=$dir
}

cleanup() {
  if [[ -n $ASKPASS_DIR ]]; then
    rm -f "$ASKPASS_DIR/password" "$ASKPASS_DIR/askpass"
    rmdir "$ASKPASS_DIR"
  fi
  sudo -k 2>/dev/null
}

# --- helpers -------------------------------------------------------------------

# Clones a repo, or fast-forwards an existing clone and says what moved
clone_or_pull() {
  local url=$1 dir=$2 branch=${3:-} name before after
  name=$(basename "$dir")
  if [[ ! -d $dir/.git ]]; then
    if [[ -e $dir ]]; then
      warn "$name: $dir exists but isn't a git checkout"
      return 1
    fi
    run git clone --quiet ${branch:+--branch "$branch"} "$url" "$dir" || return 1
    ((DRY_RUN)) || detail "$name: installed"
    return 0
  fi
  before=$(git -C "$dir" rev-parse --short HEAD) || return 1
  run git -C "$dir" pull --ff-only --quiet </dev/null || {
    warn "$name: pull failed"
    return 1
  }
  run git -C "$dir" submodule update --init --recursive --quiet </dev/null || return 1
  after=$(git -C "$dir" rev-parse --short HEAD)
  if [[ $before == "$after" ]]; then
    detail "$name: up to date"
  else
    detail "$name: $before -> $after ($(git -C "$dir" rev-list --count "$before..$after") commits)"
  fi
}

brewfile_mas_ids() { sed -nE 's/^mas .*id: *([0-9_]+).*/\1/p' "$DOTFILES/Brewfile" | tr -d _ | tr '\n' ' '; }

# Brewfile App Store apps that aren't installed (all of them before mas is)
missing_mas_ids() {
  local id installed
  if ! command -v mas >/dev/null; then
    brewfile_mas_ids
    return
  fi
  installed=$(mas list 2>/dev/null | awk '{print $1}')
  for id in $(brewfile_mas_ids); do
    grep -qx "$id" <<<"$installed" || printf '%s ' "$id"
  done
}

# --- steps ---------------------------------------------------------------------

step_preflight() {
  [[ $(uname -s) == Darwin ]] || {
    reason "macOS only"
    return 1
  }
  ((EUID != 0)) || {
    reason "run it as yourself, not root"
    return 1
  }
  curl -fsS --max-time 15 -o /dev/null https://github.com || {
    reason "can't reach github.com"
    return 1
  }
  command -v jq >/dev/null || warn "jq is missing (macOS 15 and later ship it); some checks will be skipped"
  detail "macOS $(sw_vers -productVersion) on $(uname -m), $MODE$( ((DRY_RUN)) && printf ', dry run')"
}

step_password() {
  ensure_sudo && return 0
  reason "no password: steps that need sudo will fail"
  return 1
}

clt_installed() {
  local dir
  dir=$(xcode-select -p 2>/dev/null) && [[ -x $dir/usr/bin/git ]]
}

step_command_line_tools() {
  if clt_installed; then
    # A full Xcode whose license isn't accepted yet makes git refuse to run
    if [[ $(xcrun clang 2>&1) == *license* ]]; then
      run sudo -A xcodebuild -license accept || return 1
    fi
    skip "installed"
    return 0
  fi
  # softwareupdate only lists the Command Line Tools while this file exists,
  # which is how Homebrew's installer gets them without the GUI prompt
  local marker=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress label waited=0
  run sudo -A touch "$marker"
  label=$(softwareupdate -l 2>/dev/null | grep -B1 -E 'Command Line Tools' |
    awk -F'*' '/^ *\*/ {print $2}' | sed -e 's/^ *Label: //' -e 's/^ *//' | sort -V | tail -n1)
  if [[ -n $label ]]; then
    run sudo -A softwareupdate -i "$label"
    run sudo -A xcode-select --switch /Library/Developer/CommandLineTools
  fi
  run sudo -A rm -f "$marker"
  ((DRY_RUN)) && return 0
  clt_installed && return 0
  run xcode-select --install
  detail "Finish the Command Line Tools installer that just opened; this waits for it."
  until clt_installed; do
    sleep 10
    waited=$((waited + 10))
    ((waited < 3600)) || {
      reason "timed out waiting for the Command Line Tools"
      return 1
    }
  done
}

# GitHub's ssh exits 1 even after a successful login (it has no shell to
# offer), so this goes by what it prints
github_authenticated() {
  local out
  out=$(ssh -T -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new git@github.com </dev/null 2>&1)
  [[ $out == *'successfully authenticated'* ]]
}

step_github() {
  if github_authenticated; then
    skip "already authenticated"
    return 0
  fi
  if ((DRY_RUN)); then
    detail "would create ~/.ssh/id_ed25519 if needed and wait for GitHub to accept it"
    return 0
  fi
  have_tty || {
    reason "no terminal to wait on; add an SSH key to GitHub and re-run"
    return 1
  }
  local key=$HOME/.ssh/id_ed25519 waited=0
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  if [[ ! -f $key ]]; then
    run ssh-keygen -q -t ed25519 -N '' -C "$(id -un)@$(scutil --get LocalHostName 2>/dev/null || hostname -s)" -f "$key" || return 1
  fi
  pbcopy <"$key.pub"
  open 'https://github.com/settings/ssh/new'
  detail "Your public key is on the clipboard and GitHub's New SSH key page is open."
  detail "Add it there; this carries on by itself once GitHub accepts it."
  until github_authenticated; do
    sleep 5
    waited=$((waited + 5))
    ((waited < 1800)) || {
      reason "timed out waiting for GitHub to accept the key"
      return 1
    }
  done
}

brew_bin() {
  if [[ -x /opt/homebrew/bin/brew ]]; then
    echo /opt/homebrew/bin/brew
  elif [[ -x /usr/local/bin/brew ]]; then
    echo /usr/local/bin/brew
  fi
}

step_homebrew() {
  local brew installer
  brew=$(brew_bin)
  if [[ -z $brew ]]; then
    ensure_sudo || {
      reason "installing Homebrew needs sudo"
      return 1
    }
    installer=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh) || {
      reason "couldn't download the Homebrew installer"
      return 1
    }
    run_as "NONINTERACTIVE=1 Homebrew/install/install.sh" env NONINTERACTIVE=1 /bin/bash -c "$installer" || return 1
    ((DRY_RUN)) && return 0
    brew=$(brew_bin)
  fi
  eval "$("$brew" shellenv)"
  run brew update --quiet || return 1
  # Every brew command after this one would otherwise check for updates again
  export HOMEBREW_NO_AUTO_UPDATE=1
}

step_dotfiles() {
  local branch
  if [[ ! -d $DOTFILES/.git ]]; then
    run mkdir -p "$(dirname "$DOTFILES")"
    run git clone --quiet "$DOTFILES_REPO" "$DOTFILES" </dev/null
    return
  fi
  # Other work may be in progress in this checkout, so only a clean main
  # that's behind origin moves
  branch=$(git -C "$DOTFILES" symbolic-ref --short -q HEAD)
  if [[ $branch != main ]]; then
    skip "the checkout is on ${branch:-a detached HEAD}, not main"
    return 0
  fi
  if [[ -n $(git -C "$DOTFILES" status --porcelain --untracked-files=no) ]]; then
    skip "uncommitted changes in $DOTFILES"
    return 0
  fi
  run git -C "$DOTFILES" fetch --quiet origin </dev/null || return 1
  if git -C "$DOTFILES" merge-base --is-ancestor origin/main HEAD; then
    detail "up to date"
  elif git -C "$DOTFILES" merge-base --is-ancestor HEAD origin/main; then
    run git -C "$DOTFILES" merge --ff-only --quiet origin/main
  else
    skip "main and origin/main have diverged"
    note "dotfiles: main and origin/main have diverged; merge or rebase by hand"
  fi
}

# Run from anywhere else (curl | bash), the rest runs from the clone, so it's
# the version that matches the repo. Password and log carry over.
continue_from_clone() {
  local self
  self=$(cd "$(dirname "${BASH_SOURCE[0]:-}")" 2>/dev/null && pwd -P)/$(basename "${BASH_SOURCE[0]:-bootstrap}")
  [[ $self == "$DOTFILES/scripts/bootstrap" ]] && return 0
  [[ -x $DOTFILES/scripts/bootstrap ]] || return 0
  ((DRY_RUN)) && return 0
  heading "Continuing from $DOTFILES/scripts/bootstrap"
  export BOOTSTRAP_LOG=$LOG
  exec "$DOTFILES/scripts/bootstrap" ${ARGS[@]+"${ARGS[@]}"}
}

step_oh_my_zsh() {
  local zsh_dir=$HOME/.oh-my-zsh before after installer
  if [[ -d $zsh_dir/.git ]]; then
    before=$(git -C "$zsh_dir" rev-parse --short HEAD)
    run env ZSH="$zsh_dir" /bin/zsh -f "$zsh_dir/tools/upgrade.sh" -v minimal -c 0 </dev/null || return 1
    after=$(git -C "$zsh_dir" rev-parse --short HEAD)
    if [[ $before == "$after" ]]; then
      detail "up to date"
    else
      detail "$before -> $after"
    fi
    # What `omz update` does after the script: restart the auto-update clock
    # and drop a lock an interrupted shell left behind
    if ((!DRY_RUN)); then
      printf 'LAST_EPOCH=%s\n' $(($(date +%s) / 86400)) >"$zsh_dir/cache/.zsh-update"
      find "$zsh_dir/log" -maxdepth 1 -name update.lock -type d -empty -mmin +60 -exec rmdir {} + 2>/dev/null
    fi
    return 0
  fi
  if [[ -e $zsh_dir ]]; then
    reason "$zsh_dir exists but isn't an oh-my-zsh checkout"
    return 1
  fi
  installer=$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh) || {
    reason "couldn't download the oh-my-zsh installer"
    return 1
  }
  # --unattended: no chsh and no switching into a new zsh mid-script.
  # KEEP_ZSHRC leaves an existing ~/.zshrc alone; stow replaces it anyway.
  run_as "oh-my-zsh install.sh --unattended" env RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$installer" "" --unattended
}

step_zsh_plugins() {
  local repo failed=0
  for repo in "${ZSH_PLUGINS[@]}"; do
    clone_or_pull "https://github.com/$repo" "$HOME/.oh-my-zsh/custom/plugins/${repo##*/}" || failed=1
  done
  return "$failed"
}

stow_config() { stow --dir="$DOTFILES/stow" --target="$HOME" --ignore='\.DS_Store' "$@" config; }

# What stow would refuse to replace: plain files, and links it didn't make
stow_conflicts() {
  stow_config --no --verbose 2>&1 | sed -nE \
    -e 's/.* over existing target (.+) since neither a link nor a directory.*/\1/p' \
    -e 's/.*existing target is not owned by stow: (.+)$/\1/p'
}

step_stow() {
  local top dir target stamp
  command -v stow >/dev/null || run brew install --quiet stow || return 1
  # Real directories, so stow links what's inside them instead of folding a
  # whole directory into the repo, where the app that owns it would then write
  # its state. ~/.oh-my-zsh comes from its installer, an earlier step.
  for top in "$DOTFILES"/stow/config/.[!.]* "$DOTFILES"/stow/config/*; do
    [[ -d $top ]] || continue
    dir=$(basename "$top")
    [[ $dir == .oh-my-zsh || -d $HOME/$dir ]] || run mkdir -p "$HOME/$dir"
  done
  dir="Library/Application Support/Code/User"
  [[ -d $HOME/$dir ]] || run mkdir -p "$HOME/$dir"
  [[ $(stat -f %Lp "$HOME/.ssh" 2>/dev/null) == 700 ]] || run chmod 700 "$HOME/.ssh"
  stamp=$(date +%Y%m%d-%H%M%S)
  while IFS= read -r target; do
    [[ -n $target ]] || continue
    run mv "$HOME/$target" "$HOME/$target.pre-dotfiles-$stamp" &&
      note "Moved ~/$target aside for the dotfiles version: ~/$target.pre-dotfiles-$stamp"
  done < <(stow_conflicts)
  ((DRY_RUN)) && {
    detail "then: stow config into $HOME"
    return 0
  }
  stow_config || {
    reason "stow failed (see above)"
    return 1
  }
}

# brew bundle checks what's outdated before it applies `trusted: true`, so
# without this a newly trusted entry would only be upgraded on the next run
trust_brewfile_entries() {
  local kind name trusted
  trusted=$(brew trust --json=v1 2>/dev/null | jq -r '.taps[], .formulae[], .casks[]' 2>/dev/null)
  while read -r kind name; do
    grep -qxF "$name" <<<"$trusted" && continue
    [[ $kind == brew ]] && kind=formula
    run brew trust --quiet "--$kind" "$name" || return 1
  done < <(sed -nE "s/^(brew|cask|tap) '([^']+)'.*trusted: true.*/\1 \2/p" "$DOTFILES/Brewfile")
}

# Outdated casks whose upgrade runs an installer package or removes one, which
# needs sudo
outdated_casks_needing_sudo() {
  local outdated
  outdated=$(brew outdated --cask --quiet 2>/dev/null)
  [[ -n $outdated ]] && command -v jq >/dev/null || return 0
  # shellcheck disable=SC2086 # one argument per cask
  brew info --cask --json=v2 $outdated 2>/dev/null | jq -r '
    .casks[] | select(any(.artifacts[]; has("pkg") or has("installer")
      or (has("uninstall") and (.uninstall | tostring | test("pkgutil|launchctl|kext")))))
    | .token' | tr '\n' ' '
}

upgrade_everything() {
  local sudo_casks other_casks
  sudo_casks=$(outdated_casks_needing_sudo)
  if [[ -z ${sudo_casks// /} ]] || ensure_sudo; then
    run brew upgrade --fetch-HEAD
    return
  fi
  # No password to give: upgrade everything else and say what was left
  note "Not upgraded, they need your password: brew upgrade --cask $sudo_casks"
  run brew upgrade --formula --fetch-HEAD || return 1
  other_casks=$(brew outdated --cask --quiet | grep -vxF -f <(tr ' ' '\n' <<<"$sudo_casks"))
  # shellcheck disable=SC2086 # one argument per cask
  [[ -z $other_casks ]] || run brew upgrade --cask $other_casks
}

# An app already in /Applications that Homebrew didn't install fails its cask
# in `brew bundle` unless Homebrew can adopt it, which needs the same version.
# Adopt the ones that match; skip the rest and say how to hand them over.
reconcile_unmanaged_casks() {
  local cask json app installed want
  command -v jq >/dev/null || return 0
  while IFS= read -r cask; do
    brew list --cask "$cask" >/dev/null 2>&1 && continue
    json=$(brew info --cask --json=v2 "$cask" 2>/dev/null) || continue
    app=$(jq -r '[.casks[0].artifacts[] | select(has("app")) | .app | (.[1].target? // .[0])] | first // empty' <<<"$json")
    [[ -n $app && -d /Applications/$app ]] || continue
    if [[ -d /Applications/$app/Contents/_MASReceipt ]]; then
      CASK_SKIP="$CASK_SKIP $cask"
      note "$cask: /Applications/$app came from the App Store; give it a mas entry in the Brewfile instead of a cask"
      continue
    fi
    installed=$(defaults read "/Applications/$app/Contents/Info" CFBundleShortVersionString 2>/dev/null)
    want=$(jq -r '.casks[0].version' <<<"$json")
    want=${want%%,*}
    if [[ $installed == "$want" ]] && run brew install --cask --adopt --quiet "$cask"; then
      ((DRY_RUN)) || detail "$cask: adopted the copy in /Applications"
      continue
    fi
    CASK_SKIP="$CASK_SKIP $cask"
    note "$cask: /Applications/$app (${installed:-unknown version}) wasn't installed by Homebrew and isn't the cask's version ($want). Quit it and run \`brew install --cask --force $cask\` to hand it over, or take it out of the Brewfile."
  done < <(brew bundle list --cask --file="$DOTFILES/Brewfile" 2>/dev/null)
}

# Apple's own App Store apps (iWork, GarageBand, iMovie) stay out of the
# Brewfile on purpose
apple_app_store_app() {
  local path
  path=$(mdfind "kMDItemAppStoreAdamID == $1" 2>/dev/null | head -1)
  [[ -n $path && $(defaults read "$path/Contents/Info" CFBundleIdentifier 2>/dev/null) == com.apple.* ]]
}

# Installed packages the Brewfile doesn't list: leaves only, since their
# dependencies follow them. The same dry run also lists old versions and
# orphans, which aren't drift.
report_drift() {
  local out formulae='' casks='' apps='' taps='' leaves line kind='' id
  out=$(brew bundle cleanup --file="$DOTFILES/Brewfile" 2>/dev/null)
  leaves=$(brew leaves --installed-on-request 2>/dev/null)
  while IFS= read -r line; do
    case $line in
      'Would uninstall formulae:') kind=formula ;;
      'Would uninstall casks:') kind=cask ;;
      'Would uninstall Mac App Store apps:') kind=mas ;;
      'Would untap:') kind=tap ;;
      'Would '* | '==> '* | 'Run '* | 'Warning: '*) kind='' ;;
      *)
        case $kind in
          formula) grep -qxF "$line" <<<"$leaves" && formulae="$formulae $line" ;;
          cask) casks="$casks $line" ;;
          mas)
            id=${line##*(}
            id=${id%)}
            apple_app_store_app "$id" || apps="$apps, ${line% (*}"
            ;;
          tap) taps="$taps $line" ;;
        esac
        ;;
    esac
  done <<<"$out"
  [[ -n $formulae$casks$apps$taps ]] || return 0
  note "Installed but not in the Brewfile:${formulae:+ formulae:$formulae.}${casks:+ Casks:$casks.}${apps:+ App Store:${apps#,}.}${taps:+ Taps:$taps.}"
}

step_brew_packages() {
  trust_brewfile_entries || {
    reason "couldn't apply the Brewfile's tap trust"
    return 1
  }
  if [[ $MODE == update ]]; then
    # Dependencies nothing needs any more would otherwise be upgraded too
    run brew autoremove --quiet || degrade "brew autoremove failed"
    upgrade_everything || {
      reason "brew upgrade failed (see above)"
      return 1
    }
  fi
  CASK_SKIP=${HOMEBREW_BUNDLE_CASK_SKIP:-}
  reconcile_unmanaged_casks
  # Missing App Store apps are their own step: mas can't sign in, so they
  # need you signed in to the App Store first, and that shouldn't fail the rest
  run env HOMEBREW_BUNDLE_CASK_SKIP="$CASK_SKIP" HOMEBREW_BUNDLE_MAS_SKIP="$(missing_mas_ids)" \
    brew bundle --file="$DOTFILES/Brewfile" || {
    reason "brew bundle failed (see above)"
    return 1
  }
  report_drift
}

step_app_store() {
  local missing
  command -v mas >/dev/null || {
    skip "mas isn't installed"
    return 0
  }
  missing=$(missing_mas_ids)
  if [[ -z ${missing// /} ]]; then
    skip "everything in the Brewfile is installed"
    return 0
  fi
  # shellcheck disable=SC2086 # one argument per app
  run mas install $missing || {
    manual "Sign in to the App Store, then re-run to install these apps: $missing"
    degrade "not installed: $missing(signed in to the App Store?)"
  }
}

# PJs has no cask: it's a single release zip
step_pjs() {
  local tmp
  if [[ -d /Applications/PJs.app ]]; then
    skip "installed"
    return 0
  fi
  if ((DRY_RUN)); then
    detail "would download PJs 1.0.0 from github.com/acrookston/pjs into /Applications"
    return 0
  fi
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-pjs.XXXXXX") || return 1
  run curl -fsSL -o "$tmp/PJs.zip" https://github.com/acrookston/pjs/releases/download/v1.0.0/PJs.zip &&
    run ditto -x -k "$tmp/PJs.zip" "$tmp" &&
    run mv "$tmp/PJs.app" /Applications/ || return 1
  rm -f "$tmp/PJs.zip"
  rmdir "$tmp" 2>/dev/null
  return 0
}

step_ruby() {
  local version
  command -v rbenv >/dev/null || {
    reason "rbenv isn't installed"
    return 1
  }
  version=$(<"$DOTFILES/stow/config/.rbenv/version")
  if grep -qxF "$version" <<<"$(rbenv versions --bare)"; then
    detail "Ruby $version is installed"
  else
    # rbenv-default-gems installs ~/.rbenv/default-gems into it
    run rbenv install --skip-existing "$version" || return 1
  fi
  [[ $(rbenv global) == "$version" ]] || run rbenv global "$version"
}

# Node comes from mise: ~/.config/mise/config.toml (stowed) names the global
# version, and every Node it installs gets ~/.default-npm-packages. Run from
# $HOME so that only those global settings apply.
step_node() {
  command -v mise >/dev/null || {
    reason "mise isn't installed"
    return 1
  }
  (cd "$HOME" && run mise install) || return 1
  if [[ $MODE == update ]]; then
    (cd "$HOME" && run mise upgrade) || return 1
  fi
}

step_fzf() {
  if [[ -f $HOME/.fzf.zsh ]]; then
    skip "$HOME/.fzf.zsh exists"
    return 0
  fi
  # --no-update-rc: the rc files are the repo's, and they already source ~/.fzf.*
  run "$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc --no-fish
}

# tmux-assistant-resurrect rewrites ~/.claude/settings.json with mv, replacing
# the stow link, whenever its hook commands aren't already in it exactly as it
# would write them (bash "$HOME"'<path>'). It runs on every tmux start.
check_claude_settings_link() {
  local settings=$HOME/.claude/settings.json script cmd
  [[ -e $settings ]] || return 0
  if [[ ! -L $settings ]]; then
    note "$HOME/.claude/settings.json is a plain file, not the dotfiles link: copy any new entries into stow/config/.claude/settings.json and restow"
    return 0
  fi
  [[ -d $HOME/.config/tmux/plugins/tmux-assistant-resurrect ]] && command -v jq >/dev/null || return 0
  for script in claude-session-track claude-session-cleanup; do
    # shellcheck disable=SC2016 # $HOME is literal in the hook command
    cmd='bash "$HOME"'"'/.config/tmux/plugins/tmux-assistant-resurrect/hooks/$script.sh'"
    jq -e --arg cmd "$cmd" --arg s "$script" '
      [.. | objects | .command? | strings | select(contains($s))] as $c
      | ($c | length > 0) and ($c | all(. == $cmd))' "$settings" >/dev/null ||
      note "tmux-assistant-resurrect will replace the ~/.claude/settings.json link on its next start: its $script hook in the dotfiles settings.json doesn't match what it writes"
  done
}

step_tmux_plugins() {
  local conf=$HOME/.config/tmux/tmux.conf dir=$HOME/.config/tmux/plugins spec url branch failed=0
  [[ -f $conf ]] || {
    reason "$conf is missing (did stow fail?)"
    return 1
  }
  # TPM's own scripts ask the running tmux server for the plugin list. Reading
  # tmux.conf keeps a live server out of it; updated plugins load the next time
  # tmux starts or sources its config.
  while IFS= read -r spec; do
    branch=
    if [[ $spec == *'#'* ]]; then
      branch=${spec#*#}
      spec=${spec%%#*}
    fi
    case $spec in
      *://* | git@*) url=$spec ;;
      *) url=https://github.com/$spec ;;
    esac
    spec=${spec%.git}
    clone_or_pull "$url" "$dir/${spec##*/}" "$branch" || failed=1
  done < <(sed -nE "s/^[[:space:]]*set(-option)?[[:space:]]+-g[[:space:]]+@plugin[[:space:]]+['\"]([^'\"]+)['\"].*/\2/p" "$conf")
  check_claude_settings_link
  return "$failed"
}

step_neovim() {
  local nvim_mode=install scratch rc lockfile=stow/config/.config/nvim/nvim-pack-lock.json
  command -v nvim >/dev/null || {
    reason "nvim isn't installed"
    return 1
  }
  [[ $MODE == update ]] && nvim_mode=update
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-nvim.XXXXXX") || return 1
  # From an empty directory, with TMUX unset and no shada: a bare nvim deletes
  # the saved session for its working directory when it quits, and the config's
  # tmux integration would talk to the live tmux server
  (cd "$scratch" && run env -u TMUX -u TMUX_PANE nvim --headless -i NONE \
    --cmd "lua vim.g.pack_confirm = false; vim.g.dotfiles_nvim_mode = '$nvim_mode'" \
    -c "luafile $DOTFILES/scripts/nvim-update.lua" </dev/null)
  rc=$?
  rmdir "$scratch" 2>/dev/null

  if [[ -n $(git -C "$DOTFILES" status --porcelain -- "$lockfile") ]]; then
    note "Neovim plugins moved: commit $lockfile so other machines install the same versions"
  fi
  return "$rc"
}

step_gh_extensions() {
  local ext installed
  command -v gh >/dev/null || {
    skip "gh isn't installed"
    return 0
  }
  installed=$(gh extension list 2>/dev/null | awk -F'\t' '{print $2}')
  for ext in ${GH_EXTENSIONS[@]+"${GH_EXTENSIONS[@]}"}; do
    grep -qxF "$ext" <<<"$installed" || run gh extension install "$ext" || return 1
  done
  if [[ -z $installed && ${#GH_EXTENSIONS[@]} -eq 0 ]]; then
    skip "none installed"
    return 0
  fi
  run gh extension upgrade --all
}

step_claude_code() {
  local claude installer id out
  claude=$(command -v claude || echo "$HOME/.local/bin/claude")
  if [[ ! -x $claude ]]; then
    installer=$(curl -fsSL https://claude.ai/install.sh) || {
      reason "couldn't download the Claude Code installer"
      return 1
    }
    run_as "claude.ai/install.sh" bash -c "$installer" || return 1
    ((DRY_RUN)) && return 0
  fi
  command -v jq >/dev/null || {
    skip "jq is missing"
    return 0
  }
  # Claude Code updates itself; its marketplaces and plugins don't. Plugins
  # read from a local folder are always current, and project-scoped ones
  # update from their project.
  run "$claude" plugin marketplace update >/dev/null || degrade "marketplace update failed"
  while IFS= read -r id; do
    out=$(run "$claude" plugin update "$id" --json </dev/null) || {
      degrade "$id: update failed"
      continue
    }
    [[ -z $out ]] || jq -r 'select(.updateOutcome == "updated") | "\(.plugin): \(.oldVersion) -> \(.newVersion)"' <<<"$out" | sed 's/^/    /'
  done < <("$claude" plugin list --json 2>/dev/null |
    jq -r '.[] | select(.scope == "user" and (.readFromFolder // "") == "") | .id')
}

step_opt_scripts() {
  run sudo -A mkdir -p /usr/local/opt || return 1
  run sudo -A "$(command -v stow)" --dir="$DOTFILES/stow" --target=/usr/local/opt --ignore='\.DS_Store' opt
}

step_macos_defaults() {
  # shellcheck source=scripts/macos-defaults.sh
  source "$DOTFILES/scripts/macos-defaults.sh"
  apply_macos_defaults || degrade "$DEFAULTS_FAILED settings didn't apply (see above)"
}

step_login_items() {
  local app name current
  if ((DRY_RUN)); then
    detail "would add any of these that aren't login items yet: ${LOGIN_ITEMS[*]}"
    return 0
  fi
  # The first System Events call asks you to allow it, and waits for an answer
  current=$(osascript -e 'tell application "System Events" to get the name of every login item' 2>/dev/null) || {
    manual "Allow your terminal to control System Events (Privacy & Security → Automation), then re-run for the login items"
    reason "System Events isn't scriptable from this terminal yet"
    return 1
  }
  for app in "${LOGIN_ITEMS[@]}"; do
    name=$(basename "$app" .app)
    if [[ ! -d $app ]]; then
      degrade "$name isn't installed"
      continue
    fi
    [[ ", $current, " == *", $name, "* ]] && continue
    run osascript -e "tell application \"System Events\" to make login item at end with properties {path:\"$app\", hidden:false}" >/dev/null ||
      degrade "couldn't add $name"
  done
}

# Permissions and setup that no script can do
add_reminders() {
  manual "Grant Full Disk Access to Alfred"
  manual "Grant Accessibility access to the apps that ask for it: AeroSpace, Rocket, 1Password, Alfred, AutoMute"
  manual "Install GPG Suite and set up commit signing"
}

# --- summary -------------------------------------------------------------------

restart_notes() {
  local tmux_after nvim_after old_versions
  tmux_after=$(tmux -V 2>/dev/null)
  if [[ -n $TMUX_BEFORE && $tmux_after != "$TMUX_BEFORE" ]] && pgrep -xq tmux; then
    note "tmux went from ${TMUX_BEFORE#tmux } to ${tmux_after#tmux }; the running server is still the old one until you restart it"
  fi
  nvim_after=$(nvim --version 2>/dev/null | head -1)
  if [[ -n $NVIM_BEFORE && $nvim_after != "$NVIM_BEFORE" ]] && pgrep -xq nvim; then
    note "Neovim went from ${NVIM_BEFORE#NVIM } to ${nvim_after#NVIM }; restart running instances"
  fi
  # Only superseded versions count; the dry run also lists download caches
  command -v brew >/dev/null || return 0
  old_versions=$(brew cleanup --dry-run 2>/dev/null | grep -c '/Cellar/')
  if ((old_versions > 0)); then
    note "$old_versions old Homebrew versions are kept while running programs may still use them; run \`brew cleanup\` after restarting tmux and Neovim"
  fi
}

summary() {
  local r status name info failed=0 symbol item
  heading "Summary"
  for r in ${RESULTS[@]+"${RESULTS[@]}"}; do
    status=${r%%|*}
    r=${r#*|}
    name=${r%%|*}
    info=${r#*|}
    case $status in
      ok) symbol="${green}✓${reset}" ;;
      skipped) symbol="${dim}-${reset}" ;;
      warning) symbol="${yellow}!${reset}" ;;
      *)
        symbol="${red}✗${reset}"
        failed=$((failed + 1))
        ;;
    esac
    printf '  %s %s%s\n' "$symbol" "$name" "${info:+ $dim($info)$reset}"
  done
  if ((${#MANUAL[@]})); then
    printf '\n%sTo do by hand:%s\n' "$bold" "$reset"
    for item in "${MANUAL[@]}"; do printf '  - %s\n' "$item"; done
  fi
  if ((${#NOTES[@]})); then
    printf '\n%sNotes:%s\n' "$bold" "$reset"
    for item in "${NOTES[@]}"; do printf '  - %s\n' "$item"; done
  fi
  [[ -z $LOG ]] || printf '\nLog: %s\n' "$LOG"
  ((failed == 0))
}

finish() {
  restart_notes
  summary
  exit $?
}

usage() { sed -n '3,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# --- main ----------------------------------------------------------------------

main() {
  local arg
  for arg in "$@"; do
    case $arg in
      --update) MODE=update ;;
      --dry-run) DRY_RUN=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        printf 'unknown option: %s\n' "$arg" >&2
        exit 2
        ;;
    esac
  done

  # oh-my-zsh's env.zsh exports DOTFILES through a symlink; comparisons need
  # the real path
  [[ -d $DOTFILES ]] && DOTFILES=$(cd "$DOTFILES" && pwd -P)
  mkdir -p "$STATE_DIR"
  LOG=${BOOTSTRAP_LOG:-$STATE_DIR/bootstrap-$(date +%Y%m%d-%H%M%S).log}
  if [[ -z ${BOOTSTRAP_LOG:-} ]]; then
    exec > >(tee -a "$LOG") 2>&1
  fi
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  # Same trust store as an interactive shell (oh-my-zsh's env.zsh sets this)
  export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
  # Running programs (the tmux server, Neovim) may still use the versions an
  # upgrade replaces; the summary says when to clean them up
  export HOMEBREW_NO_INSTALL_CLEANUP=1 HOMEBREW_NO_ENV_HINTS=1
  TMUX_BEFORE=$(tmux -V 2>/dev/null)
  NVIM_BEFORE=$(nvim --version 2>/dev/null | head -1)

  step "Preflight" step_preflight
  last_step_failed && finish

  if [[ $MODE == bootstrap ]]; then
    step "Password" step_password
    step "Command Line Tools" step_command_line_tools
    last_step_failed && finish
    step "GitHub SSH key" step_github
  fi
  step "Homebrew" step_homebrew
  last_step_failed && finish
  step "Dotfiles repo" step_dotfiles
  [[ -d $DOTFILES/.git ]] || ((DRY_RUN)) || finish
  continue_from_clone

  step "oh-my-zsh" step_oh_my_zsh
  step "zsh plugins" step_zsh_plugins
  step "Dotfiles into ~" step_stow
  step "Homebrew packages" step_brew_packages
  step "App Store apps" step_app_store
  step "PJs" step_pjs
  step "Ruby" step_ruby
  step "Node" step_node
  step "fzf shell integration" step_fzf
  step "tmux plugins" step_tmux_plugins
  step "Neovim plugins and parsers" step_neovim
  step "gh extensions" step_gh_extensions
  step "Claude Code" step_claude_code
  if [[ $MODE == bootstrap ]]; then
    step "Scripts in /usr/local/opt" step_opt_scripts
    step "macOS and app settings" step_macos_defaults
    step "Login items" step_login_items
    add_reminders
  fi
  finish
}

# Sourced (to test a step), it only defines the functions. Piped into bash,
# BASH_SOURCE is empty and it runs.
if [[ -n ${BASH_SOURCE[0]:-} && ${BASH_SOURCE[0]} != "$0" ]]; then
  return 0
fi
main "$@"
